<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/sebastianbergmann/phpunit/refs/tags/13.3.1/phpunit.xsd"
    beStrictAboutChangesToGlobalState="true"
    beStrictAboutCoverageMetadata="true"
    beStrictAboutOutputDuringTests="true"
    bootstrap="vendor/autoload.php"
    cacheDirectory=".cache/phpunit"
    colors="true"
    displayDetailsOnAllIssues="true"
    executionOrder="depends,random"
    failOnAllIssues="true"
    recordTestRunHistory="false"
    requireCoverageContribution="true"
    requireCoverageMetadata="true"
>
    <coverage pathCoverage="true" disableCodeCoverageIgnore="true">
        <report>
            <html outputDirectory=".cache/phpunit/coverage-html" />
            <clover outputFile=".cache/phpunit/clover.xml" />
            <text outputFile=".cache/phpunit/coverage.txt" />
        </report>
    </coverage>
    <extensions>
        <bootstrap class="Mockery\Adapter\Phpunit\Extension" />
    </extensions>
    <logging>
        <junit outputFile=".cache/phpunit/junit.xml" />
    </logging>
    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
    <testsuites>
        <testsuite name="default">
            <directory>tests/Unit</directory>
            <exclude>tests/Fixture</exclude>
        </testsuite>
        <testsuite name="phpt">
            <directory suffix=".phpt">tests/PHPT</directory>
            <exclude>tests/Fixture</exclude>
        </testsuite>
    </testsuites>
</phpunit>
